# Google Gemini (generation + embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GENERATION_MODEL=gemini-2.0-flash

# Embeddings: gemini-embedding-001 at 768 dims (stored as VARBINARY 3072 bytes)
EMBEDDING_MODEL=gemini-embedding-001
EMBED_ON_INGEST=true
SIMILARITY_THRESHOLD=0.42

# MySQL 8.0+ (embeddings stored as VARBINARY; no MySQL 9 VECTOR required)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=byte4bite
